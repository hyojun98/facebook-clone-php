{
    "intelephense.environment.phpVersion": "8.3.0",
    "php.validate.enable": false,
    "files.exclude": {
        ".runtime": true
    },
    "search.exclude": {
        ".runtime": true,
        "uploads": true
    },
    "files.watcherExclude": {
        "**/.runtime/**": true
    },
    "files.encoding": "utf8",
    "[php]": {
        "editor.tabSize": 4
    }
}
